# すべてサーバー側だけで使う。NEXT_PUBLIC_ を付けた変数は作らない。
# 値の生成例: openssl rand -base64 32

# 入場用の合言葉（8文字以上、先生用と生徒用は別の値）
TEACHER_PASSPHRASE=
STUDENT_PASSPHRASE=

# cookie 署名用のシークレット（32文字以上）
SESSION_SECRET=

# Supabase（Project Settings → API）。secret key は sb_secret_... の値（旧 service_role）
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# スクリーンショットからの本文抽出と解答の改稿に使う OpenAI API キー（任意。未設定のときは問題の取り込みと改稿だけが使えない）
OPENAI_API_KEY=
